generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERADOR
  VISUALIZADOR
}

enum EmergencyType {
  INCENDIO
  INUNDACION
  CAIDA_ARBOL
  CORTE_CAMINO
  CORTE_ELECTRICO
  DANO_VIVIENDA
  EMERGENCIA_SOCIAL
  ACCIDENTE
  RIESGO_SANITARIO
  INFRAESTRUCTURA_PUBLICA
  OTRO
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EmergencyStatus {
  NUEVA
  EN_ATENCION
  RESUELTA
  CERRADA
  DESCARTADA
}

enum ReportOrigin {
  INTERNO
  CIUDADANO
}

enum EmailTemplateType {
  ASSIGNMENT
  NEW_REPORT
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum SubscriptionPlan {
  GRATUITO
  BASICO
  PRO
}

model Municipality {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  region       String?
  commune      String?
  active       Boolean          @default(true)
  logoUrl      String?
  primaryColor String?
  plan         SubscriptionPlan @default(GRATUITO)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  users              User[]
  emergencies        Emergency[]
  emailTemplates     MunicipalityEmailTemplate[]
  webhook            MunicipalityWebhook?
  closingReasons     ClosingReason[]
  emergencyCategories EmergencyCategory[]
  operationalUnits   OperationalUnit[]
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  password       String
  role           UserRole      @default(OPERADOR)
  active         Boolean       @default(true)
  // Se incrementa al cambiar contraseña, rol o municipalidad — invalida
  // cualquier JWT emitido antes del cambio (ver requireAuth/requireSuperAdmin).
  sessionVersion Int           @default(1)
  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
  // Etiqueta organizativa opcional (ej. "Bomberos", "Obras Públicas") — solo
  // informativa, no cambia permisos ni enrutamiento de asignación.
  unitId         String?
  unit           OperationalUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  emailOnAssigned    Boolean @default(true)
  emailOnNewReport   Boolean @default(true)

  assignedEmergencies   Emergency[]           @relation("AssignedTo")
  coAssignedEmergencies EmergencyCoAssignee[] @relation("CoAssignedEmergencies")
  activityLogs          ActivityLog[]
  tasks                 Task[]
}

model Emergency {
  id             String          @id @default(cuid())
  code           String          @unique
  title          String
  description    String
  // Legado: reemplazado por categoryId (categorías configurables por
  // municipalidad). Se mantiene solo para lectura histórica de emergencias
  // creadas antes de esta migración — ningún formulario nuevo lo escribe.
  type           EmergencyType?
  categoryId     String?
  category       EmergencyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priority       Priority        @default(MEDIA)
  status         EmergencyStatus @default(NUEVA)
  address        String
  sector         String?
  region         String?
  commune        String?
  latitude       Float?
  longitude      Float?
  reporterName   String?
  reporterPhone  String?
  // Token aleatorio para /consulta (distinto del `code`, que es secuencial y
  // por tanto enumerable — nunca debe usarse como credencial de acceso público).
  publicToken       String    @unique
  consentAcceptedAt DateTime?
  origin         ReportOrigin    @default(INTERNO)
  assignedToId   String?
  assignedTo     User?           @relation("AssignedTo", fields: [assignedToId], references: [id])
  municipalityId String?
  municipality   Municipality?   @relation(fields: [municipalityId], references: [id])
  occurredAt     DateTime?
  closedAt       DateTime?
  closingNotes   String?
  closingReasonId String?
  closingReason   ClosingReason? @relation(fields: [closingReasonId], references: [id], onDelete: SetNull)
  observations   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  evidences    Evidence[]
  tasks        Task[]
  activityLogs ActivityLog[]
  coAssignees  EmergencyCoAssignee[]

  @@index([municipalityId])
  @@index([status])
  @@index([createdAt])
  @@index([municipalityId, status])
  @@index([municipalityId, createdAt])
}

model Evidence {
  id           String    @id @default(cuid())
  emergencyId  String
  emergency    Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  description  String?
  createdAt    DateTime  @default(now())
}

model Task {
  id           String     @id @default(cuid())
  emergencyId  String
  emergency    Emergency  @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       TaskStatus @default(PENDIENTE)
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ActivityLog {
  id          String    @id @default(cuid())
  emergencyId String
  emergency   Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  action      String
  description String
  createdAt   DateTime  @default(now())

  @@index([emergencyId])
}

model EmergencyCoAssignee {
  emergencyId String
  userId      String
  assignedAt  DateTime  @default(now())
  emergency   Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  user        User      @relation("CoAssignedEmergencies", fields: [userId], references: [id], onDelete: Cascade)

  @@id([emergencyId, userId])
  @@index([userId])
}

model MunicipalityEmailTemplate {
  id             String            @id @default(cuid())
  municipalityId String
  type           EmailTemplateType
  subject        String
  body           String            @db.Text
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  municipality   Municipality      @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@unique([municipalityId, type])
  @@index([municipalityId])
}

// Un webhook por municipalidad (no uno por tipo de evento, a diferencia de
// MunicipalityEmailTemplate) — un único endpoint que se suscribe a los
// eventos que la municipalidad decida vía los flags on*.
model MunicipalityWebhook {
  id                 String   @id @default(cuid())
  municipalityId     String   @unique
  url                String
  secret             String
  enabled            Boolean  @default(true)
  onEmergencyCreated Boolean  @default(true)
  onNewCitizenReport Boolean  @default(true)
  onAssignment       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  municipality        Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
}

// Motivos de cierre configurables por municipalidad — seleccionados al cerrar
// una emergencia (ver Emergency.closingReasonId), además del texto libre de
// closingNotes, no en reemplazo. `active: false` en vez de borrar para no
// invalidar el closingReasonId de emergencias históricas.
model ClosingReason {
  id             String       @id @default(cuid())
  municipalityId String
  label          String
  active         Boolean      @default(true)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  emergencies    Emergency[]

  @@index([municipalityId])
}

// Categorías de emergencia configurables por municipalidad — reemplazan el
// enum global fijo EmergencyType (que se mantiene solo para lectura histórica,
// ver Emergency.type). Cada municipalidad arranca con 11 categorías por
// defecto (mismos labels del enum anterior) y puede agregar/renombrar/
// desactivar las suyas. `active: false` en vez de borrar, mismo motivo que
// ClosingReason: no invalidar el categoryId de emergencias históricas.
model EmergencyCategory {
  id             String       @id @default(cuid())
  municipalityId String
  label          String
  active         Boolean      @default(true)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  emergencies    Emergency[]

  @@index([municipalityId])
}

// Unidad operacional — etiqueta organizativa opcional para agrupar usuarios
// dentro de una municipalidad (ej. "Bomberos", "Obras Públicas"). Sin lista
// por defecto: cada municipalidad arranca sin unidades y arma las suyas.
// Puramente informativa hoy, no afecta permisos ni asignación de emergencias.
model OperationalUnit {
  id             String       @id @default(cuid())
  municipalityId String
  label          String
  active         Boolean      @default(true)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  users          User[]

  @@index([municipalityId])
}

// Audit log global — sin FK para que no se elimine en cascada.
// Registra eventos de seguridad y operaciones destructivas de forma permanente.
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String?
  entityId    String?
  entityLabel String?
  userId      String?
  userName    String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entityType])
  @@index([userId])
}
